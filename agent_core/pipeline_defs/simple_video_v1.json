{
  "pipeline_id": "simple_video_v1",
  "mode": "default_video",
  "required_inputs": ["job.idea_or_script", "job.orientation", "job.resolution"],
  "produced_artifacts": [
    "input_job.json",
    "plan.json",
    "director_output.json",
    "scene_plan.json",
    "prompt_audit.json",
    "model_prompts.json",
    "takes.json",
    "result.json",
    "final.mp4"
  ],
  "checkpoints": [
    "validate_job",
    "create_plan",
    "approve_plan",
    "create_prompts",
    "approve_prompts",
    "generate_voice_optional",
    "render_video",
    "assemble",
    "final_quality_gate"
  ],
  "default_policy": {
    "execution": "run_existing_agent_core_flow",
    "approval_behavior": "auto_pass_unless_job_metadata_approval_gates_enabled",
    "dry_run_behavior": "stop_after_prompt_checkpoints_without_model_backends",
    "cli_fields_to_show": [
      "pipeline_id",
      "current_checkpoint_id",
      "blocked_by_checkpoint_id",
      "checkpoint_id",
      "stage",
      "status",
      "blocking",
      "approval_required",
      "approved_by",
      "reason",
      "issues",
      "warnings",
      "related_artifacts"
    ]
  },
  "retry_policy": {
    "max_attempts": 1,
    "retryable_statuses": ["failed"],
    "notes": ["Phase G1 records retry policy but keeps existing render retry behavior unchanged."]
  },
  "approval_policy": {
    "mode": "manual_file",
    "require_files_when_enabled": true,
    "approval_dir": "approvals",
    "notes": [
      "Approval gates are blocking only when job.metadata.approval_gates_enabled is true.",
      "A local approval file is /workspace/agent_runs/<job_id>/approvals/<checkpoint_id>.json with approved=true."
    ]
  },
  "steps": [
    {
      "step_id": "validate_job",
      "stage": "validation",
      "required_inputs": ["raw_job_payload"],
      "produced_artifacts": ["input_job.json", "state.json"],
      "checkpoint_id": "validate_job",
      "approval_required": false,
      "blocking": true
    },
    {
      "step_id": "create_plan",
      "stage": "planning",
      "required_inputs": ["input_job.json"],
      "produced_artifacts": ["plan.json", "director_output.json", "scene_plan.json"],
      "checkpoint_id": "create_plan",
      "approval_required": false,
      "blocking": true
    },
    {
      "step_id": "approve_plan",
      "stage": "plan_approval",
      "required_inputs": ["plan.json", "scene_plan.json", "director_output.json"],
      "produced_artifacts": ["checkpoints.json"],
      "checkpoint_id": "approve_plan",
      "approval_required": true,
      "blocking": true
    },
    {
      "step_id": "create_prompts",
      "stage": "prompt_compilation",
      "required_inputs": ["plan.json", "scene_plan.json"],
      "produced_artifacts": ["prompt_audit.json", "model_prompts.json"],
      "checkpoint_id": "create_prompts",
      "approval_required": false,
      "blocking": true
    },
    {
      "step_id": "approve_prompts",
      "stage": "prompt_approval",
      "required_inputs": ["prompt_audit.json", "model_prompts.json"],
      "produced_artifacts": ["checkpoints.json"],
      "checkpoint_id": "approve_prompts",
      "approval_required": true,
      "blocking": true
    },
    {
      "step_id": "generate_voice_optional",
      "stage": "voice",
      "required_inputs": ["plan.json"],
      "produced_artifacts": ["voice_audio"],
      "checkpoint_id": "generate_voice_optional",
      "approval_required": false,
      "blocking": false,
      "optional": true
    },
    {
      "step_id": "render_video",
      "stage": "video_render",
      "required_inputs": ["plan.json", "model_prompts.json"],
      "produced_artifacts": ["takes.json", "scene_take_videos"],
      "checkpoint_id": "render_video",
      "approval_required": false,
      "blocking": true
    },
    {
      "step_id": "assemble",
      "stage": "assembly",
      "required_inputs": ["selected_scene_outputs"],
      "produced_artifacts": ["final.mp4", "result.json"],
      "checkpoint_id": "assemble",
      "approval_required": false,
      "blocking": true
    },
    {
      "step_id": "final_quality_gate",
      "stage": "final_quality",
      "required_inputs": ["final.mp4", "result.json"],
      "produced_artifacts": ["result.json", "final_review_frames"],
      "checkpoint_id": "final_quality_gate",
      "approval_required": false,
      "blocking": true
    }
  ],
  "notes": [
    "Phase G1 definition for the existing Agent-Core video path.",
    "The definition is declarative and intentionally does not start renders by itself."
  ]
}
