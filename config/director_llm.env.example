# Copy this file to /workspace/config/director_llm.env to override defaults.

DIRECTOR_LLM_PROFILE=qwen36_llama_cpp_local
DIRECTOR_LLM_PROVIDER=llama_cpp_local
DIRECTOR_LLM_HOST=127.0.0.1
DIRECTOR_LLM_PORT=8011
DIRECTOR_LLM_BASE_URL=http://127.0.0.1:8011
DIRECTOR_LLM_PATH=/v1/chat/completions

DIRECTOR_LLM_MODEL=Qwen_Qwen3.6-35B-A3B-Q4_K_M.gguf
DIRECTOR_LLM_MODEL_REPO=bartowski/Qwen_Qwen3.6-35B-A3B-GGUF
DIRECTOR_LLM_MODEL_FILE=Qwen_Qwen3.6-35B-A3B-Q4_K_M.gguf
DIRECTOR_LLM_MODEL_DIR=/workspace/models/director/qwen3.6-35b-a3b/gguf
DIRECTOR_LLM_MODEL_PATH=/workspace/models/director/qwen3.6-35b-a3b/gguf/Qwen_Qwen3.6-35B-A3B-Q4_K_M.gguf
DIRECTOR_LLM_ALT_MODEL_REPO=sharpcaterpillar/Qwen3.6-35B-A3B-GGUF
DIRECTOR_LLM_ALT_MODEL_FILE=Qwen3.6-35B-A3B-Q4_K_M.gguf

DIRECTOR_LLM_AUTO_SETUP=on
DIRECTOR_LLM_AUTO_START=on

DIRECTOR_LLM_CTX=2048
DIRECTOR_LLM_N_GPU_LAYERS=8
DIRECTOR_LLM_THREADS=10
DIRECTOR_LLM_BATCH=512
DIRECTOR_LLM_UBATCH=512
DIRECTOR_LLM_FLASH_ATTN=on
DIRECTOR_LLM_NO_WARMUP=on
DIRECTOR_LLM_REASONING=off
DIRECTOR_LLM_REASONING_FORMAT=none
DIRECTOR_LLM_REASONING_BUDGET=0

DIRECTOR_LLM_TEMPERATURE=0.25
DIRECTOR_LLM_TIMEOUT_SEC=240
DIRECTOR_LLM_MAX_TOKENS=1800
DIRECTOR_LLM_HEALTH_TIMEOUT_SEC=10
DIRECTOR_LLM_READY_RETRIES=90
DIRECTOR_LLM_READY_SLEEP_SEC=2
DIRECTOR_LLM_CHECK_MODELS_TIMEOUT_SEC=20
DIRECTOR_LLM_CHECK_CHAT_TIMEOUT_SEC=120
DIRECTOR_LLM_CHECK_RETRIES=2
DIRECTOR_LLM_CHECK_RETRY_DELAY_SEC=3
